{
  // ei-site を Cloudflare Workers の静的アセット配信で置く設定（Cloudflareの教科書=置き場を1社に集約）
  // デプロイ（公開）は えい承認後に `npm run deploy`。ローカル確認は `npm run dev`。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ei-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // 独自ドメイン（台帳#109で取得済み・siroradio51.com・Cloudflare Registrar・DNSもCloudflare）。
  // deployすると siroradio51.com と www が本サイトに紐づく。罠帖A-2: 紐づけ後は workers.dev の仮URLが自動404（配っていないので影響なし）
  // 罠帖E-5: ゾーンには news.siroradio51.com（Rondoメール送信・Resend）のレコードがある。触らない・消さない
  "routes": [
    { "pattern": "siroradio51.com", "custom_domain": true },
    { "pattern": "www.siroradio51.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
